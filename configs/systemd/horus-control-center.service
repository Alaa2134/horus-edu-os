[Unit]
Description=HORUS Control Center — System Monitoring Dashboard
Documentation=https://github.com/alaasaber/horus-os
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=horus-user
Group=horus-user
WorkingDirectory=/opt/horus/horus-control-center/backend
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8420 --workers 1
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horus-control-center

# Resource limits
MemoryMax=256M
CPUQuota=30%

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/horus/horus-control-center
ReadOnlyPaths=/proc /sys

[Install]
WantedBy=multi-user.target graphical.target
