// HORUS OS — Fastfetch Configuration
// Shows HORUS ASCII art with system info in gold/cyan theme
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/horus/ascii-logo.txt",
        "color": {
            "1": "yellow",
            "2": "cyan"
        },
        "padding": {
            "top": 1,
            "right": 2,
            "bottom": 1
        }
    },

    "display": {
        "separator": "  │  ",
        "color": "yellow",
        "brightColor": "yellow",
        "keyWidth": 16
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}{at-symbol}{host-name}",
            "color": {
                "user": "yellow",
                "at": "cyan",
                "host": "yellow"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "format": "{pretty-name} ({id})"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "format": "{sysname} {release}"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "format": "{days}d {hours}h {minutes}m"
        },
        {
            "type": "packages",
            "key": "  Packages",
            "format": "{count} (apt)"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "format": "{pretty-name} {version}"
        },
        "separator",
        {
            "type": "display",
            "key": "  Display",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "de",
            "key": "  DE",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "wm",
            "key": "  WM",
            "format": "{pretty-name}"
        },
        {
            "type": "theme",
            "key": "  Theme",
            "format": "{name} (GTK{version})"
        },
        {
            "type": "icons",
            "key": "  Icons",
            "format": "{name}"
        },
        {
            "type": "font",
            "key": "  Font",
            "format": "{name} {size}pt"
        },
        "separator",
        {
            "type": "cpu",
            "key": "  CPU",
            "format": "{name} ({cores-physical}C/{cores-logical}T)",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "format": "{name} ({driver})"
        },
        {
            "type": "memory",
            "key": "  Memory",
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "disk",
            "key": "  Disk (/)",
            "folders": "/",
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "battery",
            "key": "  Battery",
            "format": "{capacity}% [{status}]"
        },
        {
            "type": "localip",
            "key": "  IP",
            "format": "{ipv4} ({ifname})",
            "showIpv4": true,
            "showIpv6": false
        },
        {
            "type": "temperature",
            "key": "  Temp",
            "format": "{temperature}°C"
        },
        "separator",
        {
            "type": "custom",
            "format": "[33m  HORUS OS [36m·[0m Intelligence Awakened  [33m•[0m  حورس  [36m·[0m  ذكاء مدمج"
        },
        "separator",
        "colors"
    ]
}
