# HORUS OS — System-wide GNOME defaults (dconf)
# Deployed to /etc/dconf/db/local.d/00-horus-defaults and compiled with
# `dconf update`. Users inherit these on first login; they can still override.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'
icon-theme='Yaru-dark'
cursor-theme='Yaru'
font-name='Ubuntu 11'
document-font-name='Ubuntu 11'
monospace-font-name='JetBrains Mono 11'
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true
enable-hot-corners=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Ubuntu Bold 11'
theme='Yaru-dark'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/horus/horus-pyramids.png'
picture-uri-dark='file:///usr/share/backgrounds/horus/horus-pyramids.png'
picture-options='zoom'
primary-color='#0a0a0f'
secondary-color='#12121a'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/horus/horus-pyramids.png'
picture-options='zoom'
primary-color='#0a0a0f'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/shell]
favorite-apps=['horus-browser.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'horus-control-center.desktop', 'horus-robotics.desktop', 'horus-ai.desktop', 'horus-security.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['ubuntu-dock@ubuntu.com', 'ubuntu-appindicators@ubuntu.com', 'ding@rastersoft.com']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
icon-size-fixed=true
transparency-mode='FIXED'
background-opacity=0.25
custom-theme-shrink=true
show-apps-at-top=false
running-indicator-style='DOTS'
click-action='minimize'
show-mounts=false
show-trash=false
intellihide=false
autohide=false

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true

[org/gnome/desktop/wm/keybindings]
switch-applications=['<Super>Tab']

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-timeout=900
