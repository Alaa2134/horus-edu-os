<?xml version="1.0" encoding="UTF-8"?>
<!--
  HORUS OS Desktop Configuration
  Sets wallpaper, icon layout, right-click menu.
  Deploy to: ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
-->
<channel name="xfce4-desktop" version="1.0">

  <!-- Workspace 1 — HORUS wallpaper -->
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorHDMI-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style"  type="int"    value="0"/>
          <property name="image-style"  type="int"    value="5"/>
          <property name="last-image"   type="string" value="/usr/share/horus/wallpapers/horus-default.svg"/>
        </property>
        <property name="workspace1" type="empty">
          <property name="color-style"  type="int"    value="0"/>
          <property name="image-style"  type="int"    value="5"/>
          <property name="last-image"   type="string" value="/usr/share/horus/wallpapers/horus-dark.svg"/>
        </property>
      </property>
    </property>
  </property>

  <!-- Desktop icons -->
  <property name="desktop-icons" type="empty">
    <property name="style"                type="int"  value="2"/>
    <property name="icon-size"            type="uint" value="48"/>
    <property name="icon-font-size"       type="double" value="10"/>
    <property name="icon-label-fg"        type="string" value="#e8e8f0"/>
    <property name="icon-label-bg"        type="string" value="#0a0a0f80"/>
    <property name="show-home"            type="bool" value="true"/>
    <property name="show-filesystem"      type="bool" value="true"/>
    <property name="show-trash"           type="bool" value="true"/>
    <property name="show-thumbnails"      type="bool" value="false"/>
    <property name="show-hidden-files"    type="bool" value="false"/>
    <property name="tooltip-size"         type="double" value="64"/>
  </property>

</channel>
