<?xml version="1.0" encoding="UTF-8"?>
<!--
  HORUS OS Terminal Configuration (XFCE4 Terminal)
  Dark theme with gold/cyan accents.
  Deploy to: ~/.config/xfce4/terminal/terminalrc
-->
<channel name="xfce4-terminal" version="1.0">
  <property name="general" type="empty">

    <!-- Font -->
    <property name="FontName"           type="string" value="JetBrains Mono 11"/>
    <property name="FontUseSystem"      type="bool"   value="false"/>
    <property name="FontAllowBold"      type="bool"   value="true"/>

    <!-- Colors — HORUS Dark Palette -->
    <property name="ColorForeground"    type="string" value="#e8e8f0"/>
    <property name="ColorBackground"    type="string" value="#0a0a0f"/>
    <property name="ColorCursor"        type="string" value="#c9a227"/>
    <property name="ColorBold"          type="string" value="#c9a227"/>
    <property name="ColorSelection"     type="string" value="#c9a22730"/>

    <!-- Color palette (Horus Dark 16-color) -->
    <property name="ColorPalette"       type="string"
      value="#1a1a2e;#ff4444;#00ff88;#c9a227;#1a73e8;#9b59b6;#00d4ff;#e8e8f0;#3a3a5e;#ff6b6b;#00ffaa;#f5d060;#4a9eff;#c084fc;#48e8ff;#ffffff"/>

    <!-- Scrollback -->
    <property name="ScrollingLines"     type="int"    value="10000"/>
    <property name="ScrollingUnlimited" type="bool"   value="false"/>
    <property name="ScrollingBar"       type="string" value="TERMINAL_SCROLLBAR_NONE"/>
    <property name="ScrollingOnKeystroke" type="bool" value="true"/>

    <!-- Tab bar -->
    <property name="TabBarAt"           type="string" value="TERMINAL_TAB_BAR_TOP"/>
    <property name="TabActivityColor"   type="string" value="#c9a227"/>

    <!-- Misc -->
    <property name="TitleMode"          type="string" value="TERMINAL_TITLE_REPLACE"/>
    <property name="TitleInitial"       type="string" value="HORUS Terminal"/>
    <property name="ShortcutsNoHelpKey" type="bool"   value="false"/>
    <property name="CommandLoginShell"  type="bool"   value="false"/>
    <property name="RunCustomCommand"   type="bool"   value="false"/>
    <property name="BackgroundMode"     type="string" value="TERMINAL_BACKGROUND_SOLID"/>
    <property name="CursorShape"        type="string" value="TERMINAL_CURSOR_SHAPE_IBEAM"/>
    <property name="CursorBlinks"       type="bool"   value="true"/>

    <!-- Padding -->
    <property name="Cell-height-scale"  type="double" value="1.1"/>
    <property name="Padding"            type="int"    value="4"/>

  </property>
</channel>
