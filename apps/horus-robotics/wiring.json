{
  "_meta": {
    "name": "HORUS Robotics — Wiring Helper",
    "note": "Beginner pin connections for common components. Verify voltage on your specific module before powering.",
    "version": "1.0.0"
  },
  "components": {
    "led": {
      "name": "LED",
      "needs_resistor": "220Ω–330Ω in series",
      "arduino_uno": [
        ["Anode (+, long leg)", "→ resistor → D13"],
        ["Cathode (-, short leg)", "→ GND"]
      ],
      "esp32": [
        ["Anode (+)", "→ resistor → GPIO2"],
        ["Cathode (-)", "→ GND"]
      ],
      "tip": "Start with the built-in LED on D13 (UNO) / GPIO2 (ESP32) to test without wiring."
    },
    "push_button": {
      "name": "Push Button",
      "arduino_uno": [["Leg 1", "→ D2"], ["Leg 2", "→ GND"]],
      "esp32": [["Leg 1", "→ GPIO4"], ["Leg 2", "→ GND"]],
      "tip": "Use INPUT_PULLUP in code so you don't need an external resistor."
    },
    "hc_sr04": {
      "name": "HC-SR04 Ultrasonic Distance Sensor",
      "voltage": "5V (UNO direct; ESP32 use a voltage divider on ECHO)",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["TRIG", "→ D9"], ["ECHO", "→ D10"]],
      "esp32": [["VCC", "→ 5V (VIN)"], ["GND", "→ GND"], ["TRIG", "→ GPIO5"], ["ECHO", "→ GPIO18 (via divider)"]],
      "tip": "ECHO outputs 5V — divide to ~3.3V for ESP32 (e.g. 1kΩ + 2kΩ)."
    },
    "dht22": {
      "name": "DHT22 / DHT11 Temperature & Humidity",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["DATA", "→ D2 (10kΩ pull-up to VCC)"]],
      "esp32": [["VCC", "→ 3.3V"], ["GND", "→ GND"], ["DATA", "→ GPIO4 (10kΩ pull-up)"]],
      "library": "DHT sensor library (Adafruit)"
    },
    "servo_sg90": {
      "name": "SG90 Micro Servo",
      "arduino_uno": [["Red VCC", "→ 5V"], ["Brown GND", "→ GND"], ["Orange Signal", "→ D9 (PWM)"]],
      "esp32": [["Red VCC", "→ 5V"], ["Brown GND", "→ GND"], ["Orange Signal", "→ GPIO13"]],
      "tip": "Power servos from a separate 5V supply if it jitters; share GND."
    },
    "ssd1306_oled": {
      "name": "SSD1306 OLED (I2C, 0x3C)",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["SDA", "→ A4"], ["SCL", "→ A5"]],
      "esp32": [["VCC", "→ 3.3V"], ["GND", "→ GND"], ["SDA", "→ GPIO21"], ["SCL", "→ GPIO22"]],
      "tip": "Run `i2cdetect -y 1` (or scan sketch) to confirm the 0x3C address."
    },
    "mpu6050": {
      "name": "MPU6050 Accelerometer/Gyro (I2C, 0x68)",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["SDA", "→ A4"], ["SCL", "→ A5"]],
      "esp32": [["VCC", "→ 3.3V"], ["GND", "→ GND"], ["SDA", "→ GPIO21"], ["SCL", "→ GPIO22"]]
    },
    "l298n_motor": {
      "name": "L298N Dual DC Motor Driver",
      "arduino_uno": [
        ["+12V", "→ battery +"], ["GND", "→ battery - and Arduino GND"],
        ["ENA", "→ D5 (PWM)"], ["IN1", "→ D6"], ["IN2", "→ D7"],
        ["IN3", "→ D8"], ["IN4", "→ D9"], ["ENB", "→ D10 (PWM)"]
      ],
      "esp32": [["ENA", "→ GPIO14"], ["IN1", "→ GPIO27"], ["IN2", "→ GPIO26"], ["IN3", "→ GPIO25"], ["IN4", "→ GPIO33"], ["ENB", "→ GPIO32"]],
      "tip": "Keep the 5V-enable jumper on if your supply is ≤12V."
    },
    "relay": {
      "name": "Single-Channel Relay Module",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["IN", "→ D8"]],
      "esp32": [["VCC", "→ 5V (VIN)"], ["GND", "→ GND"], ["IN", "→ GPIO23"]],
      "tip": "Most modules are active-LOW: digitalWrite(pin, LOW) turns the relay ON."
    },
    "ir_sensor": {
      "name": "IR Obstacle / Line Sensor",
      "arduino_uno": [["VCC", "→ 5V"], ["GND", "→ GND"], ["OUT", "→ D3"]],
      "esp32": [["VCC", "→ 3.3V"], ["GND", "→ GND"], ["OUT", "→ GPIO15"]]
    }
  }
}
